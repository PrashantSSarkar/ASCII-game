  "animations": {
    "idle_standing": {
      "name": "Sentinel Standing Vigil",
      "type": "procedural_harmonic",
      "frame_rate": 60,
      "cycle_duration_sec": 5.24,
      "components": {
        "character_sway": {
          "description": "Inverted pendulum breathing sway from anchored ankles to helmet crown",
          "target_sub_blocks": ["head_helm", "pauldrons", "torso_cuirass", "arms_gauntlets", "waist_fauld"],
          "amplitude_cells": 1.3,
          "frequency_rad": 1.2,
          "breathing_bob_cells": 0.5,
          "pivot_anchor_y": 100,
          "formula_x": "dx = round(A * max(0.0, (100 - y) / 95.0) * sin(1.2 * t))",
          "formula_y": "dy = round(0.5 * sin(1.2 * t))"
        },
        "cape_wind_wave": {
          "description": "Organic multi-frequency sine wave cloth ripple anchored at shoulder clasps with hem flare",
          "target_sub_blocks": ["cape_mantle"],
          "shoulder_anchor_y": 16,
          "primary_wave": { "amplitude_cells": 2.4, "omega": 0.14, "phi": 3.2 },
          "secondary_wave": { "amplitude_cells": 0.8, "omega": 0.08, "phi": 1.8 },
          "cloth_shimmer": { "enabled": true, "amplitude": 16, "frequency": 3.2 },
          "formula_x": "dx = round(cape_weight * (2.4 * sin(0.14 * y + 3.2 * t) + 0.8 * cos(0.08 * y + 1.8 * t)))",
          "formula_y": "dy = round(cape_weight * 0.5 * sin(0.10 * y + 2.5 * t))"
        },
        "weapon_greatsword_pivot": {
          "description": "Two-handed sword pivot tracking swaying gauntlets while tip remains grounded",
          "target_sub_blocks": ["weapon_sword"],
          "grounded_tip_y": 110,
          "formula_x": "dx = round(1.3 * max(0.0, (110 - y) / 68.0) * sin(1.2 * t))",
          "formula_y": "dy = round(0.5 * max(0.0, (110 - y) / 68.0) * sin(1.2 * t))"
        }
      }
    },
    "combat_idle_bob": {
      "name": "Combat Ready Battle Bounce",
      "type": "procedural_combat_harmonic",
      "frame_rate": 60,
      "cycle_duration_sec": 2.24,
      "stance_key": "Z",
      "components": {
        "side_to_side_bob": {
          "description": "Spring-loaded athletic weight shift between lead and rear leg with knee dip",
          "target_sub_blocks": ["head_helm", "pauldrons", "torso_cuirass", "arms_gauntlets", "waist_fauld", "legs_greaves"],
          "sway_amplitude_cells": 1.6,
          "vertical_dip_cells": 0.8,
          "cadence_freq_rad": 2.8,
          "formula_x": "dx = round(1.6 * max(0.0, (108 - y) / 95.0) * sin(2.8 * t))",
          "formula_y": "dy = round(0.8 * abs(cos(2.8 * t)))"
        },
        "raised_sword_inertia": {
          "description": "Dynamic sword tension tracking hands with inertia phase lag",
          "target_sub_blocks": ["weapon_sword"],
          "formula_x": "dx = round(1.6 * sin(2.8 * t - 0.35))",
          "formula_y": "dy = round(0.8 * abs(cos(2.8 * t)))"
        },
        "combat_cape_flutter": {
          "description": "Accelerated gale-force cape flutter flowing backward",
          "target_sub_blocks": ["cape_mantle"],
          "formula_x": "dx = round(cape_weight * (3.0 * sin(0.16 * y + 4.2 * t) + 1.2 * cos(0.09 * y + 2.5 * t)))",
          "formula_y": "dy = round(cape_weight * 0.7 * sin(0.14 * y + 3.5 * t))"
        }
      }
    }
  },
  "stance_controls": {
    "toggle_key": "Z",
    "default_stance": "rest_sentinel",
    "stances": {
      "rest_sentinel": {
        "matrix_key": "standing_sentinel",
        "animation": "idle_standing",
        "description": "Rest Stance: Grounded sentinel with planted greatsword, calm breathing sway"
      },
      "combat_ready": {
        "matrix_key": "combat_stance",
        "animation": "combat_idle_bob",
        "description": "Combat Stance: Diagonal raised greatsword ready to strike, athletic side-to-side bob"
      }
    },
    "transition": {
      "name": "Draw & Sheathe Weapon Movement",
      "duration_sec": 0.22,
      "reversible": true,
      "keyframes": [
        { "phase": 0.00, "matrix_key": "standing_sentinel", "description": "Rest Sentinel: blade grounded between feet" },
        { "phase": 0.25, "matrix_key": "trans_lift", "description": "Lift Initiation: tip lifts off stone, blade tilts 78 deg, knees flex" },
        { "phase": 0.50, "matrix_key": "trans_sweep", "description": "Mid-Torso Sweep: blade sweeps horizontally across chest, legs widen, cape flares" },
        { "phase": 0.75, "matrix_key": "trans_ready", "description": "High Hoist: blade elevated to 45 deg, feet landing in wide athletic base" },
        { "phase": 1.00, "matrix_key": "combat_stance", "description": "Combat Ready: active diagonal attack guard and battle bob" }
      ],
      "kinematics": {
        "knee_dip_cells": 1.8,
        "swing_momentum_cells": 1.5,
        "cape_wind_burst_cells": 4.0,
        "motion_trail": {
          "enabled": true,
          "trail_length": 5,
          "color": [180, 220, 255]
        }
      }
    }
  },
  "matrix_data_source": "assets/ascii/characters/knight_high_density.json"
